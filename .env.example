# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/signatrust"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# LocalStack (for S3 local development)
LOCALSTACK_URL="http://localhost:4566"

# Solana Configuration
SOLANA_RPC="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_PROGRAM_ID="your-program-id-here"
SOLANA_CLUSTER="https://api.devnet.solana.com"
SOLANA_KEYPAIR_PATH="path/to/keypair.json"
SOLANA_FEE_PAYER="your-fee-payer-address"

# Security - JWT Configuration (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS Configuration
AWS_REGION="us-east-1"

# AWS S3 Configuration
# For local development, use LocalStack (set S3_ENDPOINT)
# For production, use real AWS credentials and remove S3_ENDPOINT
S3_BUCKET="signatrust-documents"
S3_ENDPOINT="http://localhost:4566"  # Remove for production AWS
AWS_ACCESS_KEY_ID="test"  # Replace with real AWS key for production
AWS_SECRET_ACCESS_KEY="test"  # Replace with real AWS secret for production

# Secrets Management
# Use 'env' for local development, 'aws' for production AWS Secrets Manager
SECRETS_PROVIDER="env"
SECRETS_CACHE_TIMEOUT="300000"
# AWS_SECRETS_ENDPOINT=""  # Only for LocalStack testing

# ZK Proof Paths (Optional)
ZK_PROOF_CIRCUIT_WASM_PATH="./circuits/auth.wasm"
ZK_PROOF_CIRCUIT_PATH="./circuits/auth.zkey"
ZK_PROOF_ZKEY_PATH="./circuits/circuit_final.zkey"
ZK_PROOF_VERIFICATION_KEY="./circuits/verification_key.json"
