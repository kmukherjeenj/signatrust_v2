import axios from 'axios';

const api = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_URL || 'http://localhost:3000',
  headers: {
    'Content-Type': 'application/json',
  },
  withCredentials: true,
});

export const uploadDocument = async (document: string, metadata: any) => {
  const response = await api.post('/documents/upload', { document, metadata });
  return response.data;
};

export const getDocument = async (documentId: string, key: string) => {
  const response = await api.get(`/document/${documentId}`, { params: { key } });
  return response.data;
};

export const signDocument = async (documentId: string, signature: string) => {
  const response = await api.post(`/document/${documentId}/sign`, { signature });
  return response.data;
};

export const verifyDocument = async (documentId: string) => {
  const response = await api.get(`/document/${documentId}/verify`);
  return response.data;
};

export const createDID = async () => {
  const response = await api.post('/did/create');
  return response.data;
};

export const getDocuments = async () => {
  const response = await api.get('/document');
  return response.data;
};

export const getDocumentStatus = async (documentId: string) => {
  const response = await api.get(`/document/${documentId}/status`);
  return response.data;
};

export const getPendingSignatures = async () => {
  const response = await api.get('/document/pending-signatures');
  return response.data;
};

export const createSignatureRequest = async (documentId: string, signers: string[]) => {
  const response = await api.post('/document/signature-request', { documentId, signers });
  return response.data;
};

export default api;